# ==============================================================================
# SECURE UNIVERSITY ASSIGNMENT VIEWER (PEAKSORA) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# MongoDB Connection String (e.g., MongoDB Atlas Free Tier M0)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/peaksora_viewer?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/peaksora_assignment_viewer

# Authentication Secret (Used for signing secure session tokens and JWTs)
# Generate with: openssl rand -base64 32
AUTH_SECRET=super-secret-production-random-encryption-key-peaksora-2026

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage Provider Configuration:
# Option 1: Vercel Blob (Free Tier includes 1GB storage / 10k reads)
# Generate token in Vercel Dashboard -> Storage -> Blob
BLOB_READ_WRITE_TOKEN=

# Option 2: S3-Compatible Object Storage (AWS S3, Cloudflare R2 Free Tier 10GB)
# If using S3/R2, specify:
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=peaksora-assignments
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Fallback: If neither BLOB_READ_WRITE_TOKEN nor S3 credentials are provided,
# the application automatically uses a Secure Private Local Storage Engine
# located outside the /public directory (.private_storage/) with UUID keys
# and strictly authenticated streaming.

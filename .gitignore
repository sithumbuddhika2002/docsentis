# ==============================================================================
# Git Ignore Configuration - Next.js & Peaksora Assignment Viewer
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js Build Output
/.next/
/out/

# Production & Build Artifacts
/build
/dist

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Environment Variables & Secrets (NEVER commit credentials!)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow .env.example to be tracked in git
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo

# Application Private Storage (Local fallback uploads)
.private_storage/
*.pdf

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem

# IDE & Editor Settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
